<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>La Guaira que Viene — Propuestas para Renacer</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@700;900&display=swap" rel="stylesheet">
<style>
:root {
  --azul:#0A2540; --azul2:#1A3A5C; --verde:#00A86B; --verde2:#007A4D;
  --gris:#F4F6F9; --gris2:#E8ECF0; --gris3:#8A9BB0; --blanco:#FFFFFF;
  --oro:#C9A84C; --plata:#8A9BB0; --texto:#1A2332;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Inter',sans-serif;color:var(--texto);background:var(--blanco);line-height:1.6}

/* NAV */
nav{position:sticky;top:0;z-index:100;background:rgba(10,37,64,.97);backdrop-filter:blur(12px);padding:0 1.5rem;display:flex;align-items:center;justify-content:space-between;height:60px;border-bottom:1px solid rgba(255,255,255,.08)}
.logo{display:flex;align-items:center;gap:.5rem}
.logo-icon{width:32px;height:32px;background:var(--verde);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:1rem}
.logo-text{color:#fff;font-weight:700;font-size:.95rem;line-height:1.1}
.logo-text span{display:block;font-weight:300;font-size:.65rem;color:var(--gris3);letter-spacing:.08em;text-transform:uppercase}
.nav-links{display:none;gap:1.5rem}
.nav-links a{color:rgba(255,255,255,.75);text-decoration:none;font-size:.78rem;font-weight:500;transition:color .2s}
.nav-links a:hover{color:#fff}
.btn-participa{background:var(--verde);color:#fff;border:none;padding:.45rem 1.1rem;border-radius:6px;font-size:.78rem;font-weight:600;cursor:pointer;text-decoration:none;transition:background .2s}
.btn-participa:hover{background:var(--verde2)}
@media(min-width:768px){.nav-links{display:flex}}

/* HERO */
.hero{background:linear-gradient(135deg,var(--azul) 0%,var(--azul2) 60%,#0D3B6E 100%);min-height:90vh;display:flex;flex-direction:column;justify-content:center;padding:4rem 1.5rem 3rem;position:relative;overflow:hidden}
.hero::before{content:'';position:absolute;inset:0;background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E")}
.hero-inner{max-width:900px;margin:0 auto;width:100%}
.hero-badge{display:inline-flex;align-items:center;gap:.4rem;background:rgba(0,168,107,.15);border:1px solid rgba(0,168,107,.3);color:#4ECDA4;font-size:.68rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;padding:.35rem .8rem;border-radius:20px;margin-bottom:1.5rem}
.hero h1{font-family:'Playfair Display',serif;font-size:clamp(2rem,7vw,3.8rem);font-weight:900;color:#fff;line-height:1.1;margin-bottom:1rem}
.hero h1 em{color:var(--verde);font-style:normal}
.hero-sub{font-size:clamp(.9rem,2.5vw,1.1rem);color:rgba(255,255,255,.7);max-width:560px;margin-bottom:2rem;font-weight:300;line-height:1.7}
.hero-btns{display:flex;gap:1rem;flex-wrap:wrap;margin-bottom:3rem}
.btn-prim{background:var(--verde);color:#fff;padding:.75rem 1.6rem;border-radius:8px;font-weight:600;font-size:.88rem;text-decoration:none;border:none;cursor:pointer;transition:all .2s}
.btn-prim:hover{background:var(--verde2);transform:translateY(-1px)}
.btn-sec{background:transparent;color:#fff;padding:.75rem 1.6rem;border-radius:8px;font-weight:600;font-size:.88rem;text-decoration:none;border:1.5px solid rgba(255,255,255,.3);cursor:pointer;transition:all .2s}
.btn-sec:hover{border-color:#fff;background:rgba(255,255,255,.05)}

/* BANNER PUBLICITARIO */
.banner-pub{background:linear-gradient(90deg,rgba(0,168,107,.12),rgba(0,168,107,.05));border:1.5px dashed rgba(0,168,107,.4);border-radius:12px;padding:1.5rem;text-align:center;margin-bottom:0}
.banner-pub .banner-label{font-size:.6rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:var(--verde);margin-bottom:.4rem}
.banner-pub .banner-titulo{font-size:1.3rem;font-weight:700;color:#fff;margin-bottom:.3rem}
.banner-pub .banner-desc{font-size:.78rem;color:rgba(255,255,255,.6)}
.banner-pub .banner-dim{font-size:.6rem;color:rgba(255,255,255,.35);margin-top:.4rem}
.btn-banner{display:inline-block;margin-top:.7rem;background:var(--verde);color:#fff;padding:.4rem 1rem;border-radius:5px;font-size:.72rem;font-weight:600;text-decoration:none}

/* INDICADORES */
.indicadores{background:var(--blanco);padding:2.5rem 1.5rem;border-bottom:1px solid var(--gris2)}
.ind-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem;max-width:900px;margin:0 auto}
@media(min-width:600px){.ind-grid{grid-template-columns:repeat(5,1fr)}}
.ind-item{text-align:center;padding:1rem .5rem}
.ind-icon{font-size:1.6rem;margin-bottom:.4rem}
.ind-num{font-family:'Playfair Display',serif;font-size:1.6rem;font-weight:700;color:var(--azul);line-height:1}
.ind-label{font-size:.65rem;color:var(--gris3);font-weight:500;text-transform:uppercase;letter-spacing:.07em;margin-top:.3rem;line-height:1.3}

/* SECCIONES GENERALES */
section{padding:3rem 1.5rem}
.section-inner{max-width:900px;margin:0 auto}
.section-eyebrow{font-size:.65rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:var(--verde);margin-bottom:.6rem}
.section-title{font-family:'Playfair Display',serif;font-size:clamp(1.4rem,4vw,2rem);font-weight:700;color:var(--azul);margin-bottom:.5rem;line-height:1.2}
.section-desc{font-size:.88rem;color:var(--gris3);max-width:520px;line-height:1.7}

/* ENCUESTA */
.encuesta-section{background:var(--gris)}
.encuesta-box{background:#fff;border-radius:14px;padding:2rem;box-shadow:0 4px 24px rgba(0,0,0,.07);max-width:600px}
.encuesta-pregunta{font-weight:700;font-size:1rem;color:var(--azul);margin-bottom:1.2rem}
.opciones{display:flex;flex-direction:column;gap:.6rem;margin-bottom:1.2rem}
.opcion{display:flex;align-items:center;gap:.7rem;padding:.75rem 1rem;border:1.5px solid var(--gris2);border-radius:8px;cursor:pointer;transition:all .2s;font-size:.85rem;font-weight:500}
.opcion:hover,.opcion.sel{border-color:var(--verde);background:rgba(0,168,107,.05);color:var(--verde2)}
.opcion-dot{width:16px;height:16px;border-radius:50%;border:2px solid var(--gris2);flex-shrink:0;transition:all .2s}
.opcion.sel .opcion-dot{border-color:var(--verde);background:var(--verde)}
.btn-votar{background:var(--verde);color:#fff;border:none;padding:.75rem 2rem;border-radius:8px;font-weight:600;font-size:.88rem;cursor:pointer;width:100%;transition:background .2s}
.btn-votar:hover{background:var(--verde2)}
.votos-barra{margin-top:1rem;display:none}
.voto-item{margin-bottom:.6rem;font-size:.78rem}
.voto-label{display:flex;justify-content:space-between;margin-bottom:.2rem;color:var(--azul);font-weight:500}
.barra-bg{background:var(--gris2);border-radius:4px;height:6px}
.barra-fill{height:6px;border-radius:4px;background:var(--verde);transition:width .8s ease}

/* MAPA ZONAS */
.mapa-section{background:var(--blanco)}
.zonas-grid{display:flex;flex-direction:column;gap:.7rem;margin-top:1.5rem}
.zona-card{background:#fff;border:1px solid var(--gris2);border-left:4px solid var(--verde);border-radius:10px;overflow:hidden;cursor:pointer;transition:box-shadow .2s}
.zona-card:hover{box-shadow:0 4px 20px rgba(0,0,0,.08)}
.zona-head{display:flex;justify-content:space-between;align-items:center;padding:.9rem 1rem;gap:.5rem}
.zona-nom{font-weight:700;font-size:.92rem;color:var(--azul)}
.zona-tag{font-size:.6rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;padding:.2rem .6rem;border-radius:12px;background:rgba(0,168,107,.1);color:var(--verde2)}
.zona-body{display:none;padding:0 1rem 1rem;border-top:1px solid var(--gris2)}
.zona-card.open .zona-body{display:block}
.zona-desc{font-size:.8rem;line-height:1.6;color:#555;margin:.7rem 0}
.zona-propuesta{background:linear-gradient(135deg,rgba(0,168,107,.06),rgba(10,37,64,.04));border:1px solid rgba(0,168,107,.2);border-radius:8px;padding:.7rem .9rem;font-size:.78rem;color:var(--azul2);line-height:1.5}
.zona-propuesta strong{color:var(--verde2);display:block;font-size:.68rem;text-transform:uppercase;letter-spacing:.07em;margin-bottom:.2rem}

/* PROYECTOS */
.proyectos-section{background:var(--gris)}
.proyectos-grid{display:grid;grid-template-columns:1fr;gap:1rem;margin-top:1.5rem}
@media(min-width:600px){.proyectos-grid{grid-template-columns:repeat(3,1fr)}}
.proyecto-card{background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 2px 12px rgba(0,0,0,.06);transition:transform .2s,box-shadow .2s}
.proyecto-card:hover{transform:translateY(-3px);box-shadow:0 8px 24px rgba(0,0,0,.1)}
.proy-img{height:120px;display:flex;align-items:center;justify-content:center;font-size:2.5rem}
.proy-body{padding:1rem}
.proy-tag{font-size:.6rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--verde);margin-bottom:.4rem}
.proy-nombre{font-weight:700;font-size:.9rem;color:var(--azul);margin-bottom:.4rem;line-height:1.3}
.proy-desc{font-size:.75rem;color:var(--gris3);line-height:1.5;margin-bottom:.8rem}
.barra-prog-bg{background:var(--gris2);border-radius:4px;height:5px;margin-bottom:.4rem}
.barra-prog{height:5px;border-radius:4px;background:linear-gradient(90deg,var(--verde),#4ECDA4)}
.proy-pct{font-size:.65rem;color:var(--gris3);margin-bottom:.8rem}
.btn-ver{display:block;text-align:center;background:var(--azul);color:#fff;padding:.5rem;border-radius:6px;font-size:.75rem;font-weight:600;text-decoration:none;transition:background .2s}
.btn-ver:hover{background:var(--azul2)}

/* IDEAS */
.ideas-section{background:var(--blanco)}
.ideas-lista{display:flex;flex-direction:column;gap:.6rem;margin-top:1.2rem}
.idea-item{display:flex;align-items:center;gap:1rem;background:#fff;border:1px solid var(--gris2);border-radius:10px;padding:.8rem 1rem;transition:box-shadow .2s}
.idea-item:hover{box-shadow:0 4px 16px rgba(0,0,0,.07)}
.idea-votos{display:flex;flex-direction:column;align-items:center;min-width:40px}
.idea-voto-num{font-family:'Playfair Display',serif;font-weight:700;font-size:1.1rem;color:var(--azul);line-height:1}
.idea-voto-lab{font-size:.55rem;color:var(--gris3);text-transform:uppercase;letter-spacing:.06em}
.idea-up{font-size:1rem;cursor:pointer;color:var(--verde);margin-top:.2rem}
.idea-texto{flex:1}
.idea-titulo{font-weight:600;font-size:.85rem;color:var(--azul);margin-bottom:.2rem}
.idea-autor{font-size:.7rem;color:var(--gris3)}
.btn-proponer{display:inline-block;margin-top:1rem;background:transparent;color:var(--verde);border:1.5px solid var(--verde);padding:.6rem 1.3rem;border-radius:8px;font-weight:600;font-size:.82rem;cursor:pointer;transition:all .2s;text-decoration:none}
.btn-proponer:hover{background:var(--verde);color:#fff}

/* INSPIRACION */
.inspi-section{background:var(--azul)}
.inspi-section .section-title{color:#fff}
.inspi-section .section-desc{color:rgba(255,255,255,.6)}
.inspi-grid{display:grid;grid-template-columns:1fr;gap:1rem;margin-top:1.5rem}
@media(min-width:600px){.inspi-grid{grid-template-columns:repeat(3,1fr)}}
.inspi-card{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:12px;padding:1.2rem;transition:background .2s}
.inspi-card:hover{background:rgba(255,255,255,.1)}
.inspi-emoji{font-size:1.8rem;margin-bottom:.6rem}
.inspi-pais{font-size:.62rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--verde);margin-bottom:.3rem}
.inspi-nombre{font-weight:700;font-size:.92rem;color:#fff;margin-bottom:.4rem}
.inspi-desc{font-size:.75rem;color:rgba(255,255,255,.6);line-height:1.6}

/* PATROCINADORES */
.patros-section{background:var(--gris)}
.planes-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:.8rem;margin-top:1.5rem}
@media(min-width:600px){.planes-grid{grid-template-columns:repeat(4,1fr)}}
.plan-card{background:#fff;border-radius:12px;padding:1.2rem;text-align:center;border:2px solid var(--gris2);transition:all .2s;position:relative}
.plan-card:hover{transform:translateY(-3px);box-shadow:0 8px 24px rgba(0,0,0,.1)}
.plan-card.destacado{border-color:var(--oro);background:linear-gradient(135deg,#FFFBF0,#fff)}
.plan-badge{position:absolute;top:-10px;left:50%;transform:translateX(-50%);background:var(--oro);color:#fff;font-size:.58rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:.2rem .6rem;border-radius:10px;white-space:nowrap}
.plan-icon{font-size:1.5rem;margin-bottom:.4rem}
.plan-nombre{font-weight:700;font-size:.85rem;color:var(--azul);margin-bottom:.2rem}
.plan-precio{font-family:'Playfair Display',serif;font-size:1.3rem;font-weight:700;margin-bottom:.1rem}
.plan-periodo{font-size:.65rem;color:var(--gris3)}
.plan-sep{border:none;border-top:1px solid var(--gris2);margin:.8rem 0}
.plan-beneficios{font-size:.68rem;color:#555;line-height:1.8;text-align:left}
.btn-plan{display:block;margin-top:.8rem;background:var(--azul);color:#fff;padding:.5rem;border-radius:6px;font-size:.72rem;font-weight:600;text-decoration:none;border:none;cursor:pointer;transition:background .2s}
.btn-plan:hover{background:var(--azul2)}
.plan-card.destacado .btn-plan{background:var(--oro)}
.plan-card.destacado .btn-plan:hover{background:#B8973A}

.oro-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.8rem;margin-top:1.5rem}
.plata-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.6rem;margin-top:.8rem}
.comunidad-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:.5rem;margin-top:.8rem}
.sponsor-box{border:1.5px dashed var(--gris2);border-radius:10px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;transition:border-color .2s,background .2s;cursor:pointer}
.sponsor-box:hover{border-color:var(--verde);background:rgba(0,168,107,.03)}
.sponsor-box.oro{height:90px;padding:.5rem}
.sponsor-box.plata{height:70px;padding:.4rem}
.sponsor-box.comunidad{height:55px;padding:.3rem}
.sponsor-label{font-size:.58rem;font-weight:600;color:var(--gris3);text-transform:uppercase;letter-spacing:.07em;margin-top:.2rem}
.sponsor-dim{font-size:.52rem;color:var(--gris2);margin-top:.1rem}
.sponsor-icon{font-size:1.2rem}

.beneficios-box{background:#fff;border-radius:12px;padding:1.2rem;box-shadow:0 2px 12px rgba(0,0,0,.06);margin-top:1rem}
.beneficios-titulo{font-weight:700;font-size:.88rem;color:var(--azul);margin-bottom:.8rem}
.beneficio-item{display:flex;align-items:flex-start;gap:.5rem;font-size:.78rem;color:#444;margin-bottom:.5rem;line-height:1.4}
.check{color:var(--verde);font-weight:700;flex-shrink:0}

/* ANTES Y DESPUES */
.antdes-section{background:var(--blanco)}
.antdes-box{background:var(--gris);border-radius:14px;overflow:hidden;margin-top:1.5rem}
.antdes-labels{display:grid;grid-template-columns:1fr 1fr}
.antdes-label{padding:1.5rem;text-align:center}
.antdes-label.antes{background:linear-gradient(135deg,#2C3E50,#34495E)}
.antdes-label.despues{background:linear-gradient(135deg,var(--azul),var(--verde2))}
.antdes-emoji{font-size:2rem;margin-bottom:.5rem}
.antdes-tit{font-weight:700;font-size:.88rem;color:#fff;margin-bottom:.3rem}
.antdes-sub{font-size:.72rem;color:rgba(255,255,255,.6);line-height:1.4}

/* BANNER INFERIOR */
.banner-inferior{background:linear-gradient(90deg,var(--azul),var(--azul2));padding:1.5rem;text-align:center;border-top:3px solid var(--verde)}
.banner-inferior .label{font-size:.6rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase;color:var(--verde);margin-bottom:.3rem}
.banner-inferior .titulo{font-size:1.1rem;font-weight:700;color:#fff;margin-bottom:.2rem}
.banner-inferior .dim{font-size:.62rem;color:rgba(255,255,255,.4)}
.btn-banner-inf{display:inline-block;margin-top:.6rem;background:var(--verde);color:#fff;padding:.45rem 1.1rem;border-radius:5px;font-size:.72rem;font-weight:600;text-decoration:none}

/* FOOTER */
footer{background:#06172A;color:rgba(255,255,255,.6);padding:2.5rem 1.5rem 1.5rem}
.footer-inner{max-width:900px;margin:0 auto}
.footer-grid{display:grid;grid-template-columns:1fr;gap:1.5rem;margin-bottom:2rem}
@media(min-width:600px){.footer-grid{grid-template-columns:2fr 1fr 1fr}}
.footer-logo{font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:700;color:#fff;margin-bottom:.5rem}
.footer-about{font-size:.75rem;line-height:1.6;margin-bottom:.8rem}
.footer-social{display:flex;gap:.5rem}
.social-btn{width:30px;height:30px;background:rgba(255,255,255,.08);border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:.8rem;text-decoration:none;transition:background .2s}
.social-btn:hover{background:var(--verde)}
.footer-col h4{font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#fff;margin-bottom:.8rem}
.footer-col a{display:block;font-size:.75rem;color:rgba(255,255,255,.55);text-decoration:none;margin-bottom:.4rem;transition:color .2s}
.footer-col a:hover{color:#fff}
.newsletter-input{display:flex;gap:.4rem;margin-top:.5rem}
.newsletter-input input{flex:1;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);color:#fff;padding:.4rem .7rem;border-radius:5px;font-size:.72rem;outline:none}
.newsletter-input input::placeholder{color:rgba(255,255,255,.35)}
.newsletter-input button{background:var(--verde);color:#fff;border:none;padding:.4rem .7rem;border-radius:5px;font-size:.72rem;font-weight:600;cursor:pointer}
.footer-bottom{border-top:1px solid rgba(255,255,255,.08);padding-top:1rem;display:flex;flex-wrap:wrap;justify-content:space-between;gap:.5rem;font-size:.68rem;color:rgba(255,255,255,.35)}
.footer-bottom a{color:rgba(255,255,255,.35);text-decoration:none}
.footer-bottom a:hover{color:#fff}

.divider{height:1px;background:linear-gradient(90deg,transparent,var(--gris2),transparent);margin:0}
</style>
</head>
<body>

<!-- NAV -->
<nav>
  <div class="logo">
    <div class="logo-icon">🌊</div>
    <div class="logo-text">La Guaira que Viene<span>Propuestas para Renacer</span></div>
  </div>
  <div class="nav-links">
    <a href="#encuesta">Inicio</a>
    <a href="#proyectos">Proyectos</a>
    <a href="#mapa">Zonas</a>
    <a href="#ideas">Ideas</a>
    <a href="#patrocinadores">Patrocinadores</a>
    <a href="#footer">Contacto</a>
  </div>
  <a href="#encuesta" class="btn-participa">Participa</a>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="hero-inner">
    <div class="hero-badge">🌱 Página ciudadana · No gubernamental</div>
    <h1>Cada idea construye<br><em>nuestro futuro.</em></h1>
    <p class="hero-sub">Una plataforma ciudadana para impulsar la reconstrucción, la innovación y el desarrollo sostenible de La Guaira. Juntos podemos imaginar y construir la ciudad que merecemos.</p>
    <div class="hero-btns">
      <a href="#proyectos" class="btn-prim">Ver proyectos</a>
      <a href="#encuesta" class="btn-sec">Participar</a>
    </div>
    <!-- BANNER PRINCIPAL -->
    <div class="banner-pub">
      <div class="banner-label">Banner principal · 1200 × 250 px</div>
      <div class="banner-titulo">Tu empresa aquí</div>
      <div class="banner-desc">Construyendo juntos un mejor futuro · Asocia tu marca a la reconstrucción de La Guaira</div>
      <div class="banner-dim">Espacio publicitario disponible · Patrocinador Principal</div>
      <a href="#patrocinadores" class="btn-banner">Reservar espacio →</a>
    </div>
  </div>
</section>

<!-- INDICADORES -->
<div class="indicadores">
  <div class="ind-grid">
