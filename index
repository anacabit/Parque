<script>
// Encuesta
var seleccion=null, datos={Vivienda:45,Hospital:30,Escuelas:12,Infraestructura:8,'Agua potable':5};
function selOpc(el,op,v){
  document.querySelectorAll('.opcion').forEach(function(x){x.classList.remove('sel')});
  el.classList.add('sel'); seleccion=op;
}
function votar(){
  if(!seleccion){alert('Selecciona una opción primero');return}
  datos[seleccion]++;
  var total=Object.values(datos).reduce(function(a,b){return a+b},0);
  var b=document.getElementById('barras');
  b.style.display='block';
  b.innerHTML='<div style="font-size:.75rem;font-weight:600;color:var(--azul);margin-bottom:.8rem">Resultados actuales:</div>';
  Object.keys(datos).forEach(function(k){
    var pct=Math.round(datos[k]/total*100);
    b.innerHTML+='<div class="voto-item"><div class="voto-label"><span>'+k+'</span><span>'+pct+'%</span></div><div class="barra-bg"><div class="barra-fill" style="width:'+pct+'%"></div></div></div>';
  });
  document.querySelector('.btn-votar').textContent='¡Voto registrado! Votar de nuevo';
}
// Zonas
function toggleZC(id){
  var z=document.getElementById(id);
  var open=z.classList.contains('open');
  document.querySelectorAll('.zona-card').forEach(function(x){x.classList.remove('open')});
  if(!open)z.classList.add('open');
}
</script>
